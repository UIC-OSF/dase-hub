# DASE Hub Environment Variables
# Copy this file to .env and modify values for your deployment

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# The display name for this Hub instance
# Default: "DASE Hub"
SITE_NAME=DASE Hub

# The public URL where this Hub is served (CloudFront / Lambda Function URL).
# Used for absolute links in robots.txt, the sitemap, and security.txt.
# Leave blank until you know the deployment URL.
# SITE_URL=https://your-cloudfront-url.cloudfront.net

# The GitHub organization to display repositories and issues from.
# Default: "EqualifyEverything"
GITHUB_ORG=EqualifyEverything

# The GitHub repo (owner/name) backing the Updates/Reports content.
# Point this at a DASE-owned docs repo once one exists.
# Default: "EqualifyEverything/equalify-docs"
# DOCS_REPO=EqualifyEverything/equalify-docs

# =============================================================================
# EQUALIFY LINK-OUTS (optional)
# =============================================================================
# DASE Hub stands on its own but links out to Equalify where relevant.

# The Equalify Hub site (used for "link out to Equalify" references and the
# /dashboard and /reflow redirects).
# Default: "https://equalify.uic.edu"
# EQUALIFY_HUB_URL=https://equalify.uic.edu

# The Equalify application itself (used for the default favicon).
# Default: "https://app.equalify.uic.edu"
# EQUALIFY_APP_URL=https://app.equalify.uic.edu

# Custom favicon URL (defaults to the Equalify app's favicon)
# FAVICON_URL=https://your-app.example.com/favicon.ico

# Custom organization logo URL (defaults to an inline UIC logo)
# ORG_LOGO_URL=https://example.com/logo.png

# =============================================================================
# GITHUB OAUTH (optional — powers the repo browser sign-in)
# =============================================================================
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# =============================================================================
# AWS CONFIGURATION (for deployment)
# =============================================================================
# These are typically set in your AWS Lambda environment, not in .env.
# The app expects a DynamoDB table named "dase-hub" (region us-east-2).
# AWS_REGION=us-east-2
